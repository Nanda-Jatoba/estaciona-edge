# Porta do bot
BOT_PORT=3200
# Interface de bind. A Evolution roda em container Docker e o webhook dela NÃO
# enxerga o 127.0.0.1 do host. Use o gateway da bridge Docker da rede da Evolution
# (descubra com: docker inspect evolution-api --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}').
# Ex.: 172.20.0.1 — privado da bridge, não exposto na internet.
BOT_HOST=172.20.0.1
WEBHOOK_PATH=/webhook

# Evolution API (no próprio VPS)
EVOLUTION_URL=http://127.0.0.1:8089
EVOLUTION_APIKEY=coloque-a-apikey-aqui
EVOLUTION_INSTANCE=alertas-baluarte

# Mensagem EXATA que dispara o deploy (case-insensitive). MANTENHA SECRETA.
TRIGGER_PHRASE=deploy estaciona TROQUE-ESTA-SENHA

# Opcional: só estes números (apenas dígitos, separados por vírgula) podem disparar.
# Vazio = qualquer remetente que saiba a palavra-gatilho.
ALLOWED_NUMBERS=

# Números (com DDI/DDD) que recebem a confirmação do deploy. Pode ser uma LISTA
# separada por vírgula — todos recebem. Ex.: 5582999998888,5582988887777
NOTIFY_NUMBER=

# Script de deploy server-side
DEPLOY_SCRIPT=/opt/estacionaedge-src/deploy-bot/deploy.sh
