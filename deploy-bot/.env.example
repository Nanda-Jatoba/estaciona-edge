# Porta do bot
BOT_PORT=3200
# Interface de bind. O gateway de WhatsApp roda em container Docker e o webhook
# dele NAO enxerga o 127.0.0.1 do host. Use o gateway da bridge Docker da rede do
# container (descubra com:
#   docker inspect openwa-api --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}').
# Ex.: 172.21.0.1, privado da bridge, nao exposto na internet. Esse IP tambem
# precisa constar em SSRF_ALLOWED_HOSTS no .env do OpenWA.
BOT_HOST=172.21.0.1
WEBHOOK_PATH=/webhook

# Gateway de WhatsApp (OpenWA, no proprio VPS). O prefixo e WHATSAPP_ e nao
# OPENWA_ de proposito: o bot nao precisa saber qual gateway esta do outro lado.
WHATSAPP_API_URL=http://127.0.0.1:2786
WHATSAPP_API_KEY=coloque-a-api-key-aqui
WHATSAPP_SESSION_ID=uuid-da-sessao-do-openwa

# Mensagem EXATA que dispara o deploy (case-insensitive). MANTENHA SECRETA.
TRIGGER_PHRASE=deploy estaciona TROQUE-ESTA-SENHA

# Opcional: só estes números (apenas dígitos, separados por vírgula) podem disparar.
# Vazio = qualquer remetente que saiba a palavra-gatilho.
ALLOWED_NUMBERS=

# Números (com DDI/DDD) que recebem a confirmação do deploy. Pode ser uma LISTA
# separada por vírgula, todos recebem. Ex.: 5582999998888,5582988887777
NOTIFY_NUMBER=

# Script de deploy server-side
DEPLOY_SCRIPT=/opt/estacionaedge-src/deploy-bot/deploy.sh
